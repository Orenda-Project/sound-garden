{
  "name": "sound-garden",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:artifact": "vite build -c vite.artifact.config.js && python3 tools/stage_artifact.py",
    "preview": "vite preview --port 5390 --strictPort",
    "test": "vitest run",
    "budget": "python3 tools/landing_budget.py",
    "gates": "python3 tools/check_finch.py && python3 tools/check_decodable.py && python3 tools/so-compat/tools/check_ph_keys.py"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vitest": "^4.1.11"
  }
}
